{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "emitDeclarationOnly": false,
    "declaration": false,
    "declarationMap": false,
    "isolatedDeclarations": false,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*",
    "*.config.ts"
  ],
  "exclude": []
}
